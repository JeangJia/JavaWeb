# 统一换行符：仓库内一律 LF，避免 Windows/Mac 协作时 CRLF 造成的假 diff
* text=auto

# 源码与配置强制 LF
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sql text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell 脚本保持 LF
*.sh text eol=lf

# 二进制文件不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.war binary
*.class binary
