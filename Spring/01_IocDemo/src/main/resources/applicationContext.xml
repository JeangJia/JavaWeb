<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- 1. 注册 DAO：默认 scope 为 singleton -->
    <bean id="userDao" class="com.jeang.dao.UserDaoImpl"/>

    <!-- 2. Setter 注入 + 属性注入 -->
    <bean id="userService" class="com.jeang.service.UserService">
        <!-- 注入另一个 Bean 用 ref -->
        <property name="userDao" ref="userDao"/>
        <!-- 注入普通值用 value -->
        <property name="appName" value="IoC示例应用"/>
    </bean>

    <!-- 3. 构造器注入 -->
    <bean id="demoClass" class="com.jeang.service.DemoClass">
        <constructor-arg ref="userDao"/>
    </bean>

</beans>
